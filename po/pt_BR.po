#: extension.js:345
msgid "Application killed"
msgstr "Aplicativo encerrado à força"

#: prefs.js:48
msgid "General"
msgstr "Geral"

#: prefs.js:53
msgid "How to use"
msgstr "Como usar"

#: prefs.js:54
msgid ""
"Open the Activities overview and hold Ctrl. Every close button turns into a "
"kill button: click one to end that app at once. Release Ctrl and the buttons "
"go back to normal."
msgstr ""
"Abra a visão geral de Atividades e segure Ctrl. Todo botão de fechar vira um "
"botão de encerrar à força: clique em um para finalizar aquele aplicativo na "
"hora. Solte o Ctrl e os botões voltam ao normal."

#: prefs.js:59
msgid "Armed colour"
msgstr "Cor ao segurar Ctrl"

#: prefs.js:60
msgid "The colour the close buttons take while Ctrl is held."
msgstr ""
"A cor que os botões de fechar assumem enquanto o Ctrl está pressionado."

#: prefs.js:73
msgid "Colour"
msgstr "Cor"

#: prefs.js:74
msgid "Takes effect the next time you hold Ctrl."
msgstr "Vale a partir da próxima vez que você segurar o Ctrl."

#: prefs.js:80
msgid "Reset"
msgstr "Restaurar"

#: prefs.js:89
msgid "Default"
msgstr "Padrão"

#: prefs.js:101
msgid "About"
msgstr "Sobre"

#: prefs.js:103
msgid "Version"
msgstr "Versão"

#: prefs.js:107
msgid "Source code"
msgstr "Código-fonte"

#: prefs.js:108
msgid "Report a problem"
msgstr "Relatar um problema"

#: prefs.js:116
msgid "Sound"
msgstr "Som"

#: prefs.js:117
msgid ""
"Ogg Vorbis (.ogg, .oga) or WAV files. Follows the system setting for alert "
"sounds."
msgstr ""
"Arquivos Ogg Vorbis (.ogg, .oga) ou WAV. Segue a configuração de sons de "
"alerta do sistema."

#: prefs.js:120
msgid "Play a sound when killing"
msgstr "Tocar um som ao encerrar à força"

#: prefs.js:124
msgid "Sound file"
msgstr "Arquivo de som"

#: prefs.js:142
msgid "Play"
msgstr "Tocar"

#: prefs.js:150
msgid "Choose a file…"
msgstr "Escolher um arquivo…"

#: prefs.js:153
msgid "Use the default sound"
msgstr "Usar o som padrão"

#: prefs.js:159
msgid "Default sound"
msgstr "Som padrão"

#: prefs.js:161
msgid "File not found, the default sound plays instead"
msgstr "Arquivo não encontrado, o som padrão será tocado"

#: prefs.js:178
msgid "Sound files"
msgstr "Arquivos de som"

#: prefs.js:186
msgid "Choose a sound"
msgstr "Escolha um som"

#: prefs.js:218
msgid "Only Ogg Vorbis and WAV files can be played."
msgstr "Só é possível tocar arquivos Ogg Vorbis e WAV."
