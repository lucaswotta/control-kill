#: extension.js:134
msgid "Force Quit"
msgstr "Forçar saída"

#: extension.js:255
msgid "Application force quit"
msgstr "Aplicativo forçado a sair"

#: extension.js:258
#, javascript-format
msgid "%s was force quit"
msgstr "%s foi forçado a sair"

#: extension.js:286
msgid "Control Kill is ready"
msgstr "O Control Kill está pronto"

#: extension.js:287
msgid ""
"Hold Ctrl in the overview and click a window’s X to force quit it. Running "
"apps also get Force Quit in their right-click menu."
msgstr ""
"Segure Ctrl na visão geral e clique no X de uma janela para forçar a saída. "
"Aplicativos abertos também ganham “Forçar saída” no menu do botão direito."

#: prefs.js:76
msgid "How to use"
msgstr "Como usar"

#: prefs.js:77
msgid ""
"Open the Activities overview and hold Ctrl: every close button turns into a "
"kill button. Click one, or press Ctrl+Delete on a window selected with the "
"keyboard. Running apps also get Force Quit in their right-click menu."
msgstr ""
"Abra a visão geral de Atividades e segure Ctrl: todo botão de fechar vira um"
" botão de forçar saída. Clique em um, ou pressione Ctrl+Delete numa janela "
"selecionada pelo teclado. Aplicativos abertos também ganham “Forçar saída” "
"no menu do botão direito."

#: prefs.js:80
msgid "Behaviour"
msgstr "Comportamento"

#: prefs.js:81
msgid "Ask apps to quit first"
msgstr "Pedir para sair antes"

#: prefs.js:82
msgid "Wait three seconds for the app to exit before forcing it"
msgstr "Esperar três segundos o aplicativo sair antes de forçar"

#: prefs.js:83
msgid "Show a notification"
msgstr "Mostrar uma notificação"

#: prefs.js:84
msgid "Name the app after it is force quit"
msgstr "Informar qual aplicativo foi forçado a sair"

