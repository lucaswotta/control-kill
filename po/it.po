msgstr "Codice sorgente"

#: prefs.js:93
msgid "Report a problem"
msgstr "Segnala un problema"

#: prefs.js:107
msgid "Reset"
msgstr "Ripristina"

#: prefs.js:114
msgid "Armed colour"
msgstr "Colore con Ctrl premuto"

#: prefs.js:115
